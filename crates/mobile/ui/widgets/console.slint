import { Shell, Tap } from "../shell.slint";
import { Theme } from "../theme.slint";
import { Dialog, Label, Btn, Tone } from "basics.slint";

export component Console inherits Rectangle {
    in property <string> log;
    background: Theme.console-bg;
    border-width: 1px;
    border-color: Theme.console-border;
    border-radius: Theme.radius-sm;
    clip: true;
    changed log => { flick.content-y = min(0px, flick.height - flick.content-height); }
    flick := Flickable { interactive: !Shell.swiping && !Shell.sliding;
        mouse-drag-pan-enabled: true;
        width: 100%;
        height: 100%;
        content-height: max(body.preferred-height + 12px, self.height);
        body := Text {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            text: root.log;
            color: Theme.console-text;
            font-size: 12px;
            font-family: "monospace";
            wrap: word-wrap;
        }
    }
}

export global Picker {
    in-out property <bool> open;
    in property <string> title: "Select a File";
    in property <[string]> files;
    in property <string> hint;
    callback picked(int);
    callback canceled();
}

export component PickerDialog inherits Dialog {
    open <=> Picker.open;
    title: Picker.title;
    panel-width: 340px;
    body-height: 420px;
    closed => { Picker.canceled(); }
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Label { text: Picker.hint; font-size: 12px; weak: true; wrap: word-wrap; }
        if Picker.files.length == 0: Label { text: "Nothing matching was found in the import folder"; color: Theme.danger; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 1; wrap: word-wrap; }
        if Picker.files.length > 0: Flickable { interactive: !Shell.swiping && !Shell.sliding;
            mouse-drag-pan-enabled: true;
            vertical-stretch: 1;
            content-height: list.preferred-height;
            list := VerticalLayout {
                spacing: 4px;
                for file[index] in Picker.files: Rectangle {
                    height: 36px;
                    border-radius: Theme.radius-sm;
                    background: press.pressed ? Theme.bg-strongest : Theme.bg-strong;
                    Text { text: file; color: Theme.text; font-size: 13px; x: 8px; width: parent.width - 16px; height: parent.height; vertical-alignment: center; overflow: elide; }
                    press := Tap { enabled: !Shell.swiping; tapped => { Picker.open = false; Picker.picked(index); } }
                }
            }
        }
    }
}
