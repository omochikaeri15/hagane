import { Theme } from "../theme.slint";
import { Shell, SwipeGuard, Tap } from "../shell.slint";

export component EdgeGrab inherits TouchArea {
    in property <bool> right;
    in property <bool> armed: true;
    in property <length> reach: 240px;
    in property <bool> outermost: root.right;
    in property <bool> guarded: true;
    callback dragged(float);
    callback dropped;
    property <length> start-x;
    property <length> start-y;
    property <bool> undecided;
    property <bool> swiping;
    property <length> travel-x: self.mouse-x - self.start-x;
    property <length> travel-y: self.mouse-y - self.start-y;
    property <bool> free: root.armed && !Shell.holding && (!root.guarded || (root.right ? Shell.claim-leftward : Shell.claim-rightward) != Shell.press-seq);
    width: 100%;
    height: 100%;
    enabled: !Shell.hover-input;

    function publish(x: length, y: length) {
        if root.outermost {
            Shell.taps += 1;
            Shell.press-x = root.absolute-position.x + x;
            Shell.press-y = root.absolute-position.y + y;
            Shell.press-edge = x < Theme.edge || x > root.width - Theme.edge;
            Shell.press-seq += 1;
        }
    }

    function follow() {
        if root.swiping {
            root.dragged((root.right ? -root.travel-x : root.travel-x) / root.reach);
        } else if root.undecided && (abs(root.travel-x) > 8px || abs(root.travel-y) > 8px) {
            root.undecided = false;
            if root.free && abs(root.travel-x) > abs(root.travel-y) && (root.right ? root.travel-x < 0px : root.travel-x > 0px) {
                root.swiping = true;
                Shell.swiping = true;
                root.dragged((root.right ? -root.travel-x : root.travel-x) / root.reach);
            }
        }
    }

    changed has-hover => {
        if self.has-hover {
            root.start-x = self.mouse-x;
            root.start-y = self.mouse-y;
            root.undecided = true;
            root.publish(self.mouse-x, self.mouse-y);
        } else {
            root.undecided = false;
            if root.outermost {
                Shell.press-edge = false;
            }
            if root.swiping {
                root.swiping = false;
                Shell.swiping = false;
                root.dropped();
            }
        }
    }
    changed mouse-x => { root.follow(); }
    changed mouse-y => { root.follow(); }

    SwipeGestureHandler {
        enabled: Shell.hover-input;
        width: 100%;
        height: 100%;
        handle-swipe-left: root.right && root.free;
        handle-swipe-right: !root.right && root.free;
        changed pressed-position => { root.publish(self.pressed-position.x, self.pressed-position.y); }
        moved => { if self.swiping { root.dragged((root.right ? self.pressed-position.x - self.current-position.x : self.current-position.x - self.pressed-position.x) / root.reach); } }
        swiped => { root.dropped(); }
        cancelled => { root.dropped(); }
        @children
    }
}

export component Drawer inherits Rectangle {
    in-out property <bool> open;
    in property <bool> right;
    in property <length> panel-width: 240px;
    in property <bool> glass;
    in property <bool> scrimmed: true;
    callback opened;
    callback closed;

    width: 100%;
    height: 100%;
    background: transparent;
    visible: root.open || root.shown > 0.001 || root.dragging;

    property <length> resting: root.right ? root.width : -root.panel-width;
    property <length> revealed: root.right ? root.width - root.panel-width : 0px;
    property <float> shown;
    property <float> target: root.open ? 1.0 : 0.0;
    property <float> origin;
    property <float> began;
    property <bool> dragging;
    property <bool> settling;

    init => {
        if root.open {
            root.settling = true;
        }
    }

    changed open => {
        if !root.dragging {
            root.settling = true;
        }
    }

    public function toggle() { root.open = !root.open; }

    public function drag(fraction: float) {
        if !root.dragging {
            root.dragging = true;
            root.settling = false;
            root.origin = root.open ? 1.0 : 0.0;
            root.began = animation-tick() / 1ms;
        }
        root.shown = clamp(root.origin + fraction, 0.0, 1.0);
    }

    public function release() {
        if !root.dragging {
            return;
        }
        root.dragging = false;
        root.open = animation-tick() / 1ms - root.began < 300 && abs(root.shown - root.origin) > 0.1 ? root.shown > root.origin : root.shown > 0.5;
        root.settling = true;
        if root.open {
            root.opened();
        } else {
            root.closed();
        }
    }

    Timer {
        interval: 16ms;
        running: root.settling;
        triggered => {
            root.shown = root.shown + (root.target - root.shown) * 0.3;
            if abs(root.target - root.shown) < 0.01 {
                root.shown = root.target;
                root.settling = false;
            }
        }
    }

    if root.open && !root.right: SwipeGuard { }

    if root.open && root.scrimmed: SwipeGestureHandler {
        x: root.right ? 0px : root.panel-width;
        width: root.width - root.panel-width;
        height: 100%;
        handle-swipe-left: !root.right;
        handle-swipe-right: root.right;
        moved => { if self.swiping { root.drag(-(root.right ? self.current-position.x - self.pressed-position.x : self.pressed-position.x - self.current-position.x) / root.panel-width); } }
        swiped => { root.release(); }
        cancelled => { root.release(); }
        Tap {
            tapped => { root.open = false; root.closed(); }
        }
    }

    EdgeGrab {
        x: root.revealed;
        width: root.panel-width;
        right: !root.right;
        outermost: false;
        guarded: false;
        armed: root.open;
        enabled: !Shell.hover-input && root.open;
        reach: root.panel-width;
        dragged(fraction) => { root.drag(-fraction); }
        dropped => { root.release(); }

        slide := Rectangle {
            x: (root.resting - root.revealed) * (1.0 - root.shown);
            width: root.panel-width;
            height: 100%;
            background: root.glass ? Theme.sidebar-bg : Theme.bg-weakest;
            border-width: root.glass ? 1px : 0px;
            border-color: Theme.sidebar-border;
            border-top-left-radius: root.right ? Theme.sidebar-radius : 0px;
            border-bottom-left-radius: root.right ? Theme.sidebar-radius : 0px;
            border-top-right-radius: root.right ? 0px : Theme.radius-md;
            border-bottom-right-radius: root.right ? 0px : Theme.radius-md;
            clip: true;
            TouchArea { }
            @children
        }
    }
}
