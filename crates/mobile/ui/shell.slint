export enum Page { home, cats, enemies, stages, sandbox, mods, files, import, utilities, help, settings }

export struct Tab {
    title: string,
    page: Page,
}

export global Shell {
    in-out property <Page> page: Page.home;
    in-out property <bool> nav-open: false;
    in-out property <int> taps;
    in property <[Tab]> tabs: [
        { title: "Home", page: Page.home },
        { title: "Cats", page: Page.cats },
        { title: "Enemies", page: Page.enemies },
        { title: "Stages", page: Page.stages },
        { title: "Sandbox", page: Page.sandbox },
        { title: "Mods", page: Page.mods },
        { title: "Files", page: Page.files },
        { title: "Import", page: Page.import },
        { title: "Utilities", page: Page.utilities },
        { title: "Help", page: Page.help },
        { title: "Settings", page: Page.settings },
    ];
    in-out property <bool> toast-shown;
    in-out property <string> toast-text;
    in-out property <string> toast-detail;
    in-out property <bool> toast-danger: true;
    in property <bool> game-empty: true;
    in property <bool> engine-ready;
    in property <string> engine-phase: "Starting the data engine...";
    in property <string> engine-detail;
    in property <string> engine-fault;
    in-out property <int> engine-generation;
    in-out property <length> app-width;
    in-out property <length> app-height;
    callback navigate(Page);
    callback engine-landed();
    callback back();
    in-out property <length> press-x;
    in-out property <length> press-y;
    in-out property <bool> press-edge;
    in-out property <bool> swiping;
    in property <bool> hover-input;
    in-out property <int> press-seq;
    in-out property <int> guard-claim: -1;
    callback measured(length, length, length, length);
    callback fullscreen-changed(bool);
}

export component Tap inherits TouchArea {
    callback tapped;
    clicked => {
        if abs(self.mouse-x - self.pressed-x) <= 8px && abs(self.mouse-y - self.pressed-y) <= 8px {
            root.tapped();
        }
    }
}

export component SwipeGuard {
    in property <bool> lipped;
    property <length> left: self.absolute-position.x;
    property <length> top: self.absolute-position.y;
    property <int> claim: Shell.press-x >= self.left && Shell.press-x < self.left + self.width && Shell.press-y >= self.top && Shell.press-y < self.top + self.height && !(self.lipped && Shell.press-edge) ? Shell.press-seq : -1;
    width: 100%;
    height: 100%;
    changed claim => {
        if self.claim >= 0 {
            Shell.guard-claim = self.claim;
        }
    }
}
