import { Theme } from "../theme.slint";
import { Btn, Tone, Combo, Label, Rule, Progress } from "../widgets/basics.slint";
import { Console } from "../widgets/console.slint";
import { HeaderToggle } from "../widgets/detail.slint";

export global Import {
    in-out property <int> tab;
    in property <bool> running;

    in property <bool> device-available;
    in property <int> device-type;
    in property <int> device-region;

    in property <int> pack-region;
    in property <string> pack-label: "Select Files";
    in property <Tone> pack-tone: Tone.neutral;

    in property <int> raw-mode;
    in property <string> raw-label: "Select Data";
    in property <Tone> raw-tone: Tone.neutral;

    in property <string> action-label: "Select a Job";
    in property <Tone> action-tone: Tone.neutral;
    in property <bool> action-enabled;
    in property <float> progress: 1.0;
    in property <string> log;

    callback tab-set(int);
    callback device-type-set(int);
    callback device-region-set(int);
    callback pack-region-set(int);
    callback pick-pack();
    callback raw-mode-set(int);
    callback pick-raw();
    callback action();
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    alignment: center;
    Label { text: root.label; font-size: 14px; vertical-alignment: center; }
    @children
}

export component ImportPage inherits Rectangle {
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 4px;
            for label[index] in ["Device", "Pack", "Raw"]: HeaderToggle { label: label; selected: Import.tab == index; available: !Import.running; horizontal-stretch: 1; clicked => { Import.tab-set(index); } }
        }
        Rule { }
        if Import.tab == 0: VerticalLayout {
            spacing: 10px;
            Label { text: "Read the game installed on this device"; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
            Field { label: "Type"; Combo { width: 140px; height: 30px; text-size: 13px; options: ["Update Only", "All Content"]; current: Import.device-type; enabled: !Import.running; selected(index) => { Import.device-type-set(index); } } }
            Field { label: "Region"; Combo { width: 140px; height: 30px; text-size: 13px; options: ["Global", "Japan", "Taiwan", "Korea", "All Regions"]; current: Import.device-region; enabled: !Import.running; selected(index) => { Import.device-region-set(index); } } }
            Label { text: Import.device-type == 1 ? "All Content also copies the game's data folder, which needs a rooted device" : "Update Only reads the installed update data and needs no root"; font-size: 12px; weak: true; wrap: word-wrap; }
            if !Import.device-available: Label { text: "Installed apps can only be read on Android"; font-size: 12px; weak: true; wrap: word-wrap; }
        }
        if Import.tab == 1: VerticalLayout {
            spacing: 10px;
            Label { text: "Decrypt .pack files picked from this device"; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
            Field { label: "Region"; Combo { width: 140px; height: 30px; text-size: 13px; options: ["Global", "Japan", "Taiwan", "Korea", "All Regions"]; current: Import.pack-region; selected(index) => { Import.pack-region-set(index); } } }
            Btn { label: Import.pack-label; tone: Import.pack-tone; enabled: !Import.running; height: 32px; text-size: 13px; clicked => { Import.pick-pack(); } }
        }
        if Import.tab == 2: VerticalLayout {
            spacing: 10px;
            Label { text: "Sort archive or raw files"; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
            Field { label: "Source"; Combo { width: 120px; height: 30px; text-size: 13px; options: ["Folder", "Archive"]; current: Import.raw-mode; selected(index) => { Import.raw-mode-set(index); } } }
            Btn { label: Import.raw-label; tone: Import.raw-tone; enabled: !Import.running; height: 32px; text-size: 13px; clicked => { Import.pick-raw(); } }
        }
        Rule { }
        Btn { label: Import.action-label; tone: Import.action-tone; enabled: Import.action-enabled; height: 38px; text-size: 16px; clicked => { Import.action(); } }
        Progress { fraction: Import.progress; }
        Console { vertical-stretch: 1; log: Import.log; }
    }
}
