import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Arrow, Btn, Tone, Input, TextBox, Combo, Label, Dialog, Panel, Rule, OutlinedCard, Slider, Toggle } from "../widgets/basics.slint";
import { Drawer, EdgeGrab } from "../widgets/drawer.slint";
import { Console } from "../widgets/console.slint";
import { Shell, Tap } from "../shell.slint";

export struct ModRow { name: string, icon: image, has-icon: bool, enabled: bool, selected: bool }

export struct FinderRow { label: string, depth: int, folder: bool, open: bool, picked: bool, mark: int }

export global Finder {
    in-out property <bool> open;
    in property <string> title: "Search Attribute";
    in property <string> note;
    in property <string> hint;
    in property <string> empty;
    in-out property <string> query;
    in property <bool> building;
    in property <string> action;
    in property <bool> can-edit;
    in property <bool> can-sync;
    in property <string> sync-label: "Sync With \"game\"";
    in property <[FinderRow]> rows;

    callback searched(string);
    callback activate(int);
    callback edit();
    callback sync();
    callback closed();
}

export struct FormRow { label: string, kind: int, text: string, on: bool, options: [string], current: int }

export global Form {
    in-out property <bool> open;
    in property <string> title;
    in property <string> notice;
    in property <[FormRow]> rows;
    in property <string> sync-label: "Sync With \"game\"";
    in property <bool> failed;

    callback changed(int, string);
    callback toggled(int);
    callback picked(int, int);
    callback sync();
    callback closed();
}

export global Mods {
    in property <[ModRow]> mods;
    in-out property <string> search;
    in-out property <bool> list-open;
    in property <bool> selected;
    in-out property <string> title;
    in property <bool> enabled;
    in property <bool> mounting;
    in property <string> delete-label: "Delete";
    in property <bool> can-delete;
    in property <bool> can-edit;
    in-out property <string> author;
    in-out property <string> version;
    in-out property <string> package;
    in-out property <string> description;

    in-out property <bool> add-open;
    in property <int> add-tab;
    in-out property <string> new-name;
    in property <int> pack-type;
    in property <string> bcm-label: "Select Archive";
    in property <Tone> bcm-tone: Tone.neutral;
    in property <string> pack-label: "Select Source";
    in property <Tone> pack-tone: Tone.neutral;
    in property <bool> import-running;
    in property <bool> can-import;
    in property <string> import-log;

    in-out property <bool> export-open;
    in property <int> export-tab;
    in-out property <string> export-title;
    in-out property <string> export-package;
    in property <string> app-label: "Select App File";
    in property <Tone> app-tone: Tone.neutral;
    in property <bool> can-apply;
    in property <[string]> regions;
    in property <int> region;
    in property <int> compression;
    in property <int> compression-min;
    in property <int> compression-max;
    in-out property <string> pack-name;
    in property <bool> export-running;
    in property <string> export-log;

    callback select(int);
    callback search-changed(string);
    callback rename(string);
    callback toggle();
    callback open-export();
    callback open-edit();
    callback delete();
    callback metadata(int, string);
    callback open-add();
    callback add-tab-set(int);
    callback new-name-changed(string);
    callback pack-type-set(int);
    callback pick-bcm();
    callback pick-pack();
    callback start-import();
    callback export-tab-set(int);
    callback export-title-changed(string);
    callback export-package-changed(string);
    callback pick-app();
    callback region-set(int);
    callback compression-changed(int);
    callback pack-name-changed(string);
    callback start-export();
}

component List inherits Panel {
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        Input { text <=> Mods.search; placeholder: "Search Mods..."; text-size: 13px; height: 32px; edited(value) => { Mods.search-changed(value); } }
        Btn { tone: Tone.toggle; active: Mods.add-open; label: "Add Mod"; text-size: 13px; height: 32px; clicked => { Mods.open-add(); } }
        Rectangle { height: 4px; }
        if Mods.mods.length == 0: Label { text: "No Mods Found"; color: Theme.danger; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 1; }
        if Mods.mods.length > 0: ListView {
            mouse-drag-pan-enabled: true;
            vertical-stretch: 1;
            for row[index] in Mods.mods: Rectangle {
                height: 44px;
                width: parent.width;
                Rectangle {
                    y: 0;
                    height: 40px;
                    width: parent.width;
                    border-radius: Theme.radius-sm;
                    background: row.selected ? Theme.primary : (press.pressed ? Theme.bg-strongest : Theme.bg-strong);
                    border-width: row.enabled ? 2px : 0px;
                    border-color: Theme.success;
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 4px;
                        if row.has-icon: Rectangle { width: 40px; Image { source: row.icon; width: 32px; height: 32px; x: 4px; y: 4px; image-fit: contain; } }
                        Text { text: row.name; color: row.selected ? Theme.white : Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    }
                    press := Tap { enabled: !Shell.swiping; tapped => { Mods.select(index); Mods.list-open = false; } }
                }
            }
        }
    }
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Label { text: root.label; font-size: 14px; width: 90px; vertical-alignment: center; }
    @children
}

component Details inherits VerticalLayout {
    padding: 16px;
    spacing: 8px;
    Input { text <=> Mods.title; placeholder: "Mod Title"; text-size: 22px; height: 44px; accepted(value) => { Mods.rename(value); } }
    Rule { }
    actions := HorizontalLayout {
        spacing: 8px;
        Btn { tone: Mods.enabled ? Tone.danger : Tone.success; label: Mods.enabled ? "Disable" : "Enable"; enabled: !Mods.mounting; text-size: 13px; height: 32px; width: (actions.width - 24px) / 4; clicked => { Mods.toggle(); } }
        Btn { label: "Edit"; enabled: Mods.can-edit; text-size: 13px; height: 32px; width: (actions.width - 24px) / 4; clicked => { Mods.open-edit(); } }
        Btn { label: "Export"; text-size: 13px; height: 32px; width: (actions.width - 24px) / 4; clicked => { Mods.open-export(); } }
        Btn { tone: Tone.danger; label: Mods.delete-label; enabled: Mods.can-delete && !Mods.mounting; text-size: 13px; height: 32px; width: (actions.width - 24px) / 4; clicked => { Mods.delete(); } }
    }
    Rule { }
    OutlinedCard {
        height: info.preferred-height + 24px;
        info := VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Label { text: "Information"; font-size: 18px; }
            Rule { }
            Field { label: "Author"; Input { text <=> Mods.author; text-size: 14px; height: 32px; horizontal-stretch: 1; edited(value) => { Mods.metadata(0, value); } } }
            Field { label: "Version"; Input { text <=> Mods.version; text-size: 14px; height: 32px; horizontal-stretch: 1; edited(value) => { Mods.metadata(1, value); } } }
            Field { label: "Package"; Input { text <=> Mods.package; text-size: 14px; height: 32px; horizontal-stretch: 1; edited(value) => { Mods.metadata(2, value); } } }
        }
    }
    OutlinedCard {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Label { text: "Description"; font-size: 18px; }
            Rule { }
            TextBox { vertical-stretch: 1; text <=> Mods.description; placeholder: "Enter mod description here..."; edited(value) => { Mods.metadata(3, value); } }
        }
    }
}

component Tabs inherits HorizontalLayout {
    in property <[string]> labels;
    in property <int> current;
    callback picked(int);
    spacing: 8px;
    for label[index] in root.labels: Btn { tone: Tone.toggle; active: root.current == index; label: label; text-size: 13px; height: 30px; horizontal-stretch: 1; clicked => { root.picked(index); } }
}

component AddDialog inherits Dialog {
    title: "Add Mod";
    open <=> Mods.add-open;
    panel-width: 360px;
    body-height: Shell.app-height / 2;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Tabs { labels: ["New", "BCM", "Pack"]; current: Mods.add-tab; picked(index) => { Mods.add-tab-set(index); } }
        Rule { }
        if Mods.add-tab == 0: VerticalLayout {
            spacing: 8px;
            Label { text: "Start a blank mod with the standard internal layout"; font-size: 14px; wrap: word-wrap; }
            Field { label: "Name"; Input { width: 140px; height: 30px; text-size: 14px; placeholder: "My Mod"; text <=> Mods.new-name; enabled: !Mods.import-running; edited(value) => { Mods.new-name-changed(value); } } }
            Btn { width: 150px; height: 30px; text-size: 13px; label: "Create Mod"; tone: Mods.can-import ? Tone.primary : Tone.neutral; enabled: Mods.can-import && !Mods.import-running; clicked => { Mods.start-import(); } }
        }
        if Mods.add-tab == 1: VerticalLayout {
            spacing: 8px;
            Label { text: "Import packaged .bcm or .zip mod archives placed in the import folder"; font-size: 14px; wrap: word-wrap; }
            Btn { width: 150px; height: 30px; text-size: 13px; label: Mods.bcm-label; tone: Mods.bcm-tone; enabled: !Mods.import-running; clicked => { Mods.pick-bcm(); } }
            Btn { width: 150px; height: 30px; text-size: 13px; label: "Start Import"; tone: Mods.can-import ? Tone.primary : Tone.neutral; enabled: Mods.can-import && !Mods.import-running; clicked => { Mods.start-import(); } }
        }
        if Mods.add-tab == 2: VerticalLayout {
            spacing: 8px;
            Label { text: "Import modded files directly from game formats placed in the import folder"; font-size: 14px; wrap: word-wrap; }
            Field { label: "Format"; Combo { width: 120px; height: 30px; text-size: 13px; options: ["APK", "Pack"]; current: Mods.pack-type; selected(index) => { Mods.pack-type-set(index); } } }
            Field { label: "Source"; Btn { width: 150px; height: 30px; text-size: 13px; label: Mods.pack-label; tone: Mods.pack-tone; enabled: !Mods.import-running; clicked => { Mods.pick-pack(); } } }
            Btn { width: 150px; height: 30px; text-size: 13px; label: "Start Import"; tone: Mods.can-import ? Tone.primary : Tone.neutral; enabled: Mods.can-import && !Mods.import-running; clicked => { Mods.start-import(); } }
        }
        Rule { }
        Console { vertical-stretch: 1; log: Mods.import-log; }
    }
}

component ExportDialog inherits Dialog {
    title: "Export Mod";
    open <=> Mods.export-open;
    panel-width: 360px;
    body-height: Shell.app-height * 2 / 3;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Tabs { labels: ["APK", "BCM", "Pack"]; current: Mods.export-tab; picked(index) => { Mods.export-tab-set(index); } }
        Rule { }
        if Mods.export-tab == 0: VerticalLayout {
            spacing: 8px;
            Label { text: "Patch and export modded APK"; font-size: 14px; wrap: word-wrap; }
            Field { label: "Title"; Input { width: 160px; height: 30px; text-size: 14px; text <=> Mods.export-title; enabled: !Mods.export-running; edited(value) => { Mods.export-title-changed(value); } } }
            Field { label: "Package"; Input { width: 160px; height: 30px; text-size: 14px; text <=> Mods.export-package; enabled: !Mods.export-running; edited(value) => { Mods.export-package-changed(value); } } }
            Field { label: "Region"; Combo { width: 140px; height: 30px; text-size: 13px; options: Mods.regions; current: Mods.region; selected(index) => { Mods.region-set(index); } } }
            Field { label: "App File"; Btn { width: 150px; height: 30px; text-size: 13px; label: Mods.app-label; tone: Mods.app-tone; enabled: !Mods.export-running; clicked => { Mods.pick-app(); } } }
            Btn { width: 150px; height: 30px; text-size: 13px; label: "Apply Mod"; tone: Mods.can-apply ? Tone.primary : Tone.neutral; enabled: Mods.can-apply && !Mods.export-running; clicked => { Mods.start-export(); } }
        }
        if Mods.export-tab == 1: VerticalLayout {
            spacing: 8px;
            Label { text: "Package mod into a standalone .bcm archive"; font-size: 14px; wrap: word-wrap; }
            Field { label: "Title"; Input { width: 160px; height: 30px; text-size: 14px; text <=> Mods.export-title; enabled: !Mods.export-running; edited(value) => { Mods.export-title-changed(value); } } }
            Field { label: "Compression"; Slider { guarded: false; minimum: Mods.compression-min; maximum: Mods.compression-max; value: Mods.compression; enabled: !Mods.export-running; changed(value) => { Mods.compression-changed(value); } } Label { text: Mods.compression; font-size: 13px; vertical-alignment: center; } }
            Btn { width: 170px; height: 30px; text-size: 13px; label: "Create BCM Package"; enabled: Mods.selected && !Mods.export-running; clicked => { Mods.start-export(); } }
        }
        if Mods.export-tab == 2: VerticalLayout {
            spacing: 8px;
            Label { text: "Compile mod files into raw .pack and .list files"; font-size: 14px; wrap: word-wrap; }
            Field { label: "Name"; Input { width: 160px; height: 30px; text-size: 14px; placeholder: "DownloadLocal"; text <=> Mods.pack-name; enabled: !Mods.export-running; edited(value) => { Mods.pack-name-changed(value); } } }
            Field { label: "Key"; Combo { width: 140px; height: 30px; text-size: 13px; options: Mods.regions; current: Mods.region; selected(index) => { Mods.region-set(index); } } }
            Btn { width: 150px; height: 30px; text-size: 13px; label: "Create Pack"; enabled: Mods.selected && !Mods.export-running; clicked => { Mods.start-export(); } }
        }
        Rule { }
        Console { vertical-stretch: 1; log: Mods.export-log; }
    }
}

component FinderDialog inherits Dialog {
    title: Finder.title;
    open <=> Finder.open;
    closed => { Finder.closed(); }
    panel-width: 360px;
    body-height: Shell.app-height * 2 / 3;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Label { text: Finder.note; font-size: 13px; horizontal-alignment: center; }
        Input { text <=> Finder.query; placeholder: Finder.hint; text-size: 13px; height: 32px; edited(value) => { Finder.searched(value); } }
        OutlinedCard {
            vertical-stretch: 1;
            if Finder.building: Label { width: parent.width; height: parent.height; text: "Reading files..."; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            if !Finder.building && Finder.rows.length == 0: Label { width: parent.width; height: parent.height; text: Finder.empty; color: Theme.danger; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            if !Finder.building && Finder.rows.length > 0: ListView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                mouse-drag-pan-enabled: true;
                for row[index] in Finder.rows: Rectangle {
                    height: 32px;
                    width: parent.width;
                    border-radius: Theme.radius-sm;
                    background: row.picked ? Theme.primary : (press.pressed ? Theme.bg-strongest : (row.mark == 1 ? Theme.warning.with-alpha(0.3) : (row.mark == 2 ? Theme.success.with-alpha(0.3) : transparent)));
                    HorizontalLayout {
                        padding-left: 6px + row.depth * 12px;
                        padding-right: 6px;
                        spacing: 4px;
                        Rectangle {
                            width: 14px;
                            if row.folder: Arrow { open: row.open; }
                        }
                        Text { text: row.label; color: row.picked ? Theme.white : Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    }
                    press := Tap { enabled: !Shell.swiping; tapped => { Finder.activate(index); } }
                }
            }
        }
        Btn { label: Finder.action; tone: Finder.can-edit ? Tone.primary : Tone.neutral; enabled: Finder.can-edit; text-size: 13px; height: 32px; clicked => { Finder.edit(); } }
        Btn { label: Finder.sync-label; tone: Tone.danger; enabled: Finder.can-sync; text-size: 13px; height: 32px; clicked => { Finder.sync(); } }
    }
}

component FormDialog inherits Dialog {
    title: Form.title;
    open <=> Form.open;
    closed => { Form.closed(); }
    panel-width: 360px;
    body-height: Shell.app-height * 2 / 3;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        if Form.notice != "": Label { text: Form.notice; weak: true; font-size: 12px; }
        if Form.failed: Label { text: "The last change could not be saved"; color: Theme.danger; font-size: 13px; horizontal-alignment: center; }
        OutlinedCard {
            vertical-stretch: 1;
            ListView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                mouse-drag-pan-enabled: true;
                for row[index] in Form.rows: VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    if row.kind == 5: Label { text: row.label; font-size: 12px; weak: true; }
                    if row.kind == 5: Input { height: 32px; text-size: 13px; text: row.text; edited(value) => { Form.changed(index, value); } }
                    if row.kind != 5: HorizontalLayout {
                        spacing: 8px;
                        Label { text: row.label; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                        if row.kind <= 1: Input { width: 130px; height: 32px; text-size: 13px; text: row.text; fill: row.kind == 1 ? Theme.danger.with-alpha(0.25) : Theme.input-bg; edited(value) => { Form.changed(index, value); } }
                        if row.kind == 2: Toggle { width: 130px; value: row.on; changed(value) => { Form.toggled(index); } }
                        if row.kind == 3: Combo { width: 130px; height: 32px; text-size: 13px; options: row.options; current: row.current; selected(at) => { Form.picked(index, at); } }
                        if row.kind == 4: Label { width: 130px; text: row.text; weak: true; font-size: 12px; vertical-alignment: center; }
                    }
                }
            }
        }
        Btn { tone: Tone.danger; label: Form.sync-label; text-size: 13px; height: 32px; clicked => { Form.sync(); } }
    }
}

export component ModsPage inherits Rectangle {
    EdgeGrab { armed: !Mods.list-open && !Shell.nav-open; reach: drawer.panel-width; dragged(fraction) => { drawer.drag(fraction); } dropped => { drawer.release(); }
        if !Mods.selected: Label { text: "Please select or import a Mod"; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; width: parent.width - 32px; x: 16px; height: parent.height; wrap: word-wrap; }
        if Mods.selected: Details { width: parent.width; height: parent.height; }
    }
    drawer := Drawer {
        open <=> Mods.list-open;
        panel-width: min(220px, root.width * 0.6);
        List { width: 100%; height: 100%; }
    }
    AddDialog { }
    ExportDialog { }
    FinderDialog { }
    FormDialog { }
}
