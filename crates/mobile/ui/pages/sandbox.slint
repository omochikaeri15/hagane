export struct DeckCell { filled: bool, aimed: bool, flagged: bool, registered: bool, icon: image, has-icon: bool, fallback: string, level: string, cost: string, has-cost: bool, barred: bool, talented: bool, np: image, has-np: bool, orbs: [image] }
export struct ComboSample { name: string, effect: string, note: string }
export struct ComboRow { line: int, name: string, effect: string, note: string, active: bool, banned: bool, icons: [image], has: [bool] }
export struct JailBonus { id: int, title: string, detail: string, icon: image, has-icon: bool, fallback: string, level: int, limit: int, permanent: bool }
export struct SavedRow { index: int, name: string, count: string, selected: bool }
export struct ConfigEntry { label: string, hint: string, value: string }
export struct ItemRow { label: string, on: bool, allowed: bool }
export struct VitalRow { name: string, hp: string }
export struct Field { label: string, lines: [Line] }
export struct ReplayRow { label: string, selected: bool, depth: int, folder: bool, expanded: bool, parent: int, levels: int, room: int }

