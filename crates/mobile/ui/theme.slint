export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg: dark ? #212121 : #f5f5f5;
    out property <color> text: dark ? #e6e6e6 : #191919;
    out property <color> primary: #1f6aa5;
    out property <color> success: dark ? #2ea05a : #1e8250;
    out property <color> warning: dark ? #d2b43c : #b48214;
    out property <color> danger: dark ? #d23c3c : #be2828;
    out property <color> bg-weakest: dark ? #282828 : #ebebeb;
    out property <color> bg-weaker: dark ? #323232 : #dedede;
    out property <color> bg-weak: dark ? #3a3a3a : #d4d4d4;
    out property <color> bg-strong: dark ? #474747 : #c4c4c4;
    out property <color> bg-stronger: dark ? #4e4e4e : #bcbcbc;
    out property <color> bg-strongest: dark ? #555555 : #b4b4b4;
    out property <color> primary-weak: dark ? #205684 : #a4b3ca;
    out property <color> primary-strong: #0088df;
    out property <color> primary-text: #f9fafb;
    out property <color> secondary: dark ? #848484 : #909090;
    out property <color> stat-header: dark ? #0f0f0f : #dbdbdb;
    out property <color> stat-value: dark ? #3a3a3a : #ffffff;
    out property <color> stat-border: dark ? #2a2a2a : #eeeeee;
    out property <color> white: #ffffff;

    out property <color> weak-text: text.with-alpha(0.4);
    out property <color> primary-hover: primary.with-alpha(0.8);
    out property <color> success-hover: success.with-alpha(0.8);
    out property <color> warning-hover: warning.with-alpha(0.8);
    out property <color> danger-hover: danger.with-alpha(0.8);
    out property <color> sidebar-bg: (dark ? #0c0c0c : #565656).with-alpha(0.95);
    out property <color> sidebar-border: dark ? #141414 : #939393;
    out property <color> sidebar-solid: dark ? #0c0c0c : #565656;
    out property <color> outlined-bg: dark ? #1a1a1a : #bfbfbf;
    out property <color> outlined-border: text.with-alpha(0.35);
    out property <color> dark-panel: dark ? #141414 : #989898;
    out property <color> workspace-bg: dark ? #1a1a1a : #bfbfbf;
    out property <color> workspace-border: dark ? #5a5a5a : #d1d1d1;
    out property <color> workspace-header: dark ? #111111 : #7b7b7b;
    out property <color> card-bg: (dark ? #050505 : #252525).with-alpha(0.92);
    out property <color> card-muted: (dark ? #050505 : #252525).with-alpha(0.368);
    out property <color> card-danger: (dark ? #5f1b1b : #561212).with-alpha(0.5);
    out property <color> card-primary-border: #144569;
    out property <color> outline: dark ? #7a7a7a : #f9f9f9;
    out property <color> disabled-bg: dark ? #232323 : #7f7f7f;
    out property <color> input-bg: dark ? #111111 : #7b7b7b;
    out property <color> list-hover: text.with-alpha(0.15);
    out property <color> progress-track: dark ? #121212 : #878787;
    out property <color> table-header: dark ? #121212 : #878787;
    out property <color> table-row: dark ? #1a1a1a : #c4c4c4;
    out property <color> console-border: dark ? #080808 : #3d3d3d;
    out property <color> console-bg: dark ? #0d0d0d : #626262;
    out property <color> console-text: dark ? #d7d7d7 : #f5f5f5;
    out property <color> hint-bg: (dark ? #050505 : #252525).with-alpha(0.627);
    out property <color> info-border: dark ? #757575 : #d3d3d3;
    out property <color> notice-bg: #000000.with-alpha(0.863);
    out property <color> toggle-knob-hover: primary-text.with-alpha(0.5);
    out property <color> controls-bg: (dark ? #050505 : #252525).with-alpha(0.627);
    out property <color> viewer-missing: dark ? #141414 : #939393;
    out property <color> popup-chrome: dark ? #171717 : #acacac;
    out property <color> scrim: #000000.with-alpha(0.55);

    out property <length> text-size: 16px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    out property <length> sidebar-width: 180px;
    out property <length> sidebar-padding: 15px;
    out property <length> sidebar-radius: 10px;
    out property <length> tab-height: 42px;
    out property <length> tab-spacing: 6px;
    out property <length> tab-text: 16px;
    out property <duration> slide: 260ms;
    out property <length> toast-overhang: 4px;
    out property <length> edge: 44px;
}
